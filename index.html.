<!DOCTYPE html>
<html lang="en">
<head>
  <!-- ========== META ========== -->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Leon – Super Creative &amp; Minimal Agency Web Template</title>
  <meta name="description" content="Leon: a super creative and minimal agency one-page website.">

  <!-- Google Font: Work Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;600;800&display=swap" rel="stylesheet">

  <style>
    /* ========== 1. DESIGN TOKENS (colors, font, sizes) ========== */
    :root {
      --teal: #00c9b1;        /* main accent: headings, icons, links */
      --slate: #2c4654;       /* dark blue-grey: text, footer, side menu */
      --text: #6b7780;        /* body text */
      --bg-soft: #fafafa;     /* light grey section background */
      --watermark: #f0f1f2;   /* big faint section words */
      --font: "Work Sans", "Segoe UI", Arial, sans-serif;
      --max: 1000px;          /* content max width */
    }

    /* ========== 2. RESET & BASE ========== */
    *, *::before, *::after { box-sizing: border-box; margin: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: var(--font); color: var(--text); background: #fff; line-height: 1.7; font-size: 15px; }
    img { max-width: 100%; display: block; }
    a { color: inherit; text-decoration: none; }
    h1, h2, h3 { color: var(--slate); line-height: 1.2; }
    :focus-visible { outline: 3px solid var(--teal); outline-offset: 3px; } /* keyboard focus */

    /* Font Awesome inline icon: takes the text colour via currentColor */
    .fa { fill: currentColor; flex-shrink: 0; }

    /* Centered content wrapper */
    .container { width: min(100% - 40px, var(--max)); margin-inline: auto; }

    /* Section spacing */
    .section { padding: 90px 0; }
    .section--soft { background: var(--bg-soft); }

    /* Section heading: big faint word (data-bg) behind a small tagline */
    .section-head { position: relative; text-align: center; margin-bottom: 64px; padding-top: 40px; }
    .section-head::before {
      content: attr(data-bg);
      position: absolute; left: 50%; top: 0; transform: translateX(-50%);
      font-size: clamp(3.5rem, 12vw, 7rem); font-weight: 800; color: var(--watermark);
      line-height: 1; z-index: 0; pointer-events: none;
    }
    .section-head p { position: relative; z-index: 1; margin-top: 36px; font-size: 1rem; color: var(--slate); }

    /* Outline button (Show Me More) */
    .btn {
      display: inline-block; padding: 8px 22px; border: 2px solid var(--slate);
      font-weight: 600; font-size: .8rem; color: var(--slate); transition: background .2s, color .2s;
    }
    .btn:hover { background: var(--slate); color: #fff; }

    /* ========== 3. HEADER (logo + menu button) ========== */
    .header { position: absolute; top: 0; left: 0; right: 0; z-index: 5; }
    .header__inner { display: flex; justify-content: space-between; align-items: center; height: 80px; }
    .logo { font-size: 1.8rem; font-weight: 800; color: var(--slate); letter-spacing: 2px; }
    .logo span { color: var(--teal); }

    /* Menu button made of two lines */
    .menu-btn { background: none; border: 0; cursor: pointer; padding: 8px; display: grid; gap: 6px; }
    .menu-btn span { display: block; width: 24px; height: 2px; background: var(--slate); }

    /* ========== 4. SIDE MENU (opens from the right) ========== */
    .overlay { position: fixed; inset: 0; background: rgba(0,0,0,.35); opacity: 0; visibility: hidden; transition: opacity .3s; z-index: 9; }
    .side-menu {
      position: fixed; top: 0; right: 0; bottom: 0; width: min(300px, 85%); background: var(--slate); color: #cdd8de;
      padding: 40px 32px; transform: translateX(100%); transition: transform .3s; z-index: 10; overflow-y: auto;
    }
    .side-menu h4 { font-size: .75rem; font-weight: 400; color: #7f98a6; margin: 32px 0 10px; }
    .side-menu a { display: block; padding: 4px 0; }
    .side-menu a:hover, .side-menu .is-current { color: var(--teal); }
    .side-menu__close { background: none; border: 0; color: #fff; font-size: 1.8rem; cursor: pointer; line-height: 1; }
    /* JS adds .menu-open on <body> to show the menu */
    .menu-open .side-menu { transform: none; }
    .menu-open .overlay { opacity: 1; visibility: visible; }

    /* ========== 5. HERO ========== */
    .hero { padding-top: 130px; text-align: center; }
    .hero h1 { color: var(--teal); font-size: clamp(1.8rem, 5vw, 2.4rem); font-weight: 800; margin-bottom: 18px; }
    .hero p { max-width: 260px; margin: 0 auto 48px; font-size: .9rem; }
    /* Mountain strip: photo fades into white at the top */
    .hero__image {
      height: 280px;
      background: linear-gradient(#fff 0%, rgba(255,255,255,0) 55%), url("images/hero.jpg") center 75% / cover;
    }

    /* ========== 6. THREE FEATURES ========== */
    .features { display: grid; grid-template-columns: repeat(3, 1fr); text-align: center; margin-top: -10px; }
    .feature { padding: 48px 28px; background: #fff; }
    .feature--raised { box-shadow: 0 12px 30px rgba(0,0,0,.08); } /* the middle card lifts slightly */
    .feature .fa { display: block; width: 2.2rem; height: 2.2rem; margin: 0 auto 20px; color: var(--teal); }
    .feature h3 { font-size: .85rem; margin-bottom: 10px; }
    .feature p { font-size: .8rem; }


    /* ========== 7. SERVICES ========== */
    .services { display: grid; grid-template-columns: 1.3fr 1fr; gap: 56px; align-items: center; }
    .services__list { display: grid; grid-template-columns: 1fr 1fr; gap: 36px 28px; }
    .service { display: grid; grid-template-columns: 28px 1fr; gap: 12px; }
    .service .fa { width: 1.1rem; height: 1.1rem; color: var(--teal); margin-top: 4px; }
    .service h3 { font-size: .85rem; margin-bottom: 6px; }
    .service p { font-size: .75rem; line-height: 1.6; }
    /* Photo with a dark slate rectangle offset behind it */
    .services__photo { position: relative; }
    .services__photo::before { content: ""; position: absolute; top: -24px; right: -24px; width: 100%; height: 100%; background: var(--slate); }
    .services__photo img { position: relative; width: 100%; height: 300px; object-fit: cover; object-position: 55% 70%; }

    /* ========== 8. PORTFOLIO ========== */
    .projects { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 48px; }
    .project { background: #fff; box-shadow: 0 2px 10px rgba(0,0,0,.04); }
    .project img { width: 100%; height: 170px; object-fit: cover; }
    .project__body { padding: 16px 18px 20px; }
    .project h3 { font-size: .85rem; margin-bottom: 6px; }
    .project p { font-size: .75rem; line-height: 1.6; }
    .center { text-align: center; }

    /* ========== 9. ABOUT ========== */
    .about { display: grid; grid-template-columns: 1fr 1.2fr; gap: 64px; align-items: center; max-width: 820px; margin-inline: auto; }
    /* Photo with a teal "L" shape (right bar + bottom bar) */
    .about__photo { position: relative; padding: 0 40px 40px 0; }
    .about__photo::before { content: ""; position: absolute; top: 24px; right: 0; width: 40px; bottom: 0; background: var(--teal); }
    .about__photo::after  { content: ""; position: absolute; right: 0; bottom: 0; width: 70%; height: 40px; background: var(--teal); }
    .about__photo img { position: relative; z-index: 1; width: 100%; height: 260px; object-fit: cover; object-position: 50% 50%; }
    .about__text strong { display: block; color: var(--slate); font-size: .95rem; margin-bottom: 18px; line-height: 1.8; }
    .about__text hr { width: 120px; border: 0; border-top: 2px solid var(--teal); margin: 20px 0; }
    .about__text p { font-size: .8rem; }

    /* ========== 10. CONTACT ========== */
    .contact { text-align: left; max-width: 820px; margin-inline: auto; }
    .contact h3 { font-size: 1.5rem; margin-bottom: 8px; }
    .contact__mail { display: block; color: var(--teal); font-size: 1.6rem; font-weight: 600; margin-bottom: 28px; }
    .contact__social { display: flex; align-items: center; gap: 18px; font-size: .8rem; }
    .contact__social .fa { width: 1.1rem; height: 1.1rem; }
    .contact__social a:hover { color: var(--teal); }

    /* ========== 11. FOOTER ========== */
    .footer { background: var(--slate); color: #fff; text-align: center; padding: 16px 0; font-size: .7rem; }
    .footer span { color: var(--teal); }

    /* ========== 12. RESPONSIVE ========== */
    @media (max-width: 800px) {
      .features, .projects { grid-template-columns: 1fr; }
      .services, .about { grid-template-columns: 1fr; gap: 48px; }
      .services__list { grid-template-columns: 1fr; }
      .services__photo::before { top: -14px; right: -14px; }
      .section { padding: 64px 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .side-menu, .overlay, .btn { transition: none; }
    }
  </style>
</head>

