  <!-- ========== JAVASCRIPT: side menu behaviour ========== -->
  <script>
    const body = document.body;
    const openBtn = document.getElementById('menu-open');

    // Open or close the side menu by toggling a class on <body>
    function setMenu(isOpen) {
      body.classList.toggle('menu-open', isOpen);
      openBtn.setAttribute('aria-expanded', isOpen);
    }

    openBtn.addEventListener('click', () => setMenu(true));                          // menu button
    document.getElementById('menu-close').addEventListener('click', () => setMenu(false)); // × button
    document.getElementById('overlay').addEventListener('click', () => setMenu(false));    // click outside
    document.addEventListener('keydown', e => { if (e.key === 'Escape') setMenu(false); }); // Esc key

    // Close the menu after choosing a link
    document.querySelectorAll('.side-menu a').forEach(a => a.addEventListener('click', () => setMenu(false)));
  </script>
